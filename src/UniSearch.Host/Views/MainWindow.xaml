<!-- ⚠ 不要给下面的 Window 加 TextOptions.TextFormattingMode="Display"：
     它按 GDI 兼容方式做像素对齐，在分数 DPI 缩放 + 用户替换字体（"新微软雅黑"）的机器上
     笔画发虚（"墨水不够"）—— AWD 项目 2026-10-04 定案的真因（速同步没设它所以同机清晰）。
     WPF 默认就是 Ideal，什么都不写才是对的。同类教训见记忆库 GEN-2026-10-04-01。 -->
<Window x:Class="UniSearch.Host.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UniSearch.Host.ViewModels"
        xmlns:conv="clr-namespace:UniSearch.Host.Converters"
        Title="UniSearch"
        Width="1280" Height="660" MinWidth="860" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Surface}"
        FontFamily="{StaticResource Font.Text}"
        AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Activated="OnWindowActivated"
        Closing="OnWindowClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisStd" />
        <!-- 取反：紧凑态 = "不是展开态" -->
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <!-- 鼠标事件挂根节点：右键要先把选中落到光标下那一行，再弹 shell 菜单 -->
    <Grid Margin="6"
          PreviewMouseRightButtonDown="OnRootPreviewMouseRightDown"
          PreviewMouseRightButtonUp="OnRootPreviewMouseRightUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 搜索行（全宽：它是全局输入，不属于任何一栏） -->
            <RowDefinition Height="*"/>     <!-- 三栏主体 -->
            <RowDefinition Height="Auto"/>  <!-- 状态条 -->
        </Grid.RowDefinitions>

        <!-- ── 搜索行 ───────────────────────────────────── -->
        <Border Grid.Row="0" Height="{StaticResource SearchBox.Height}"
                CornerRadius="{StaticResource Radius.Default}"
                Background="{StaticResource Brush.Surface.Card}"
                BorderBrush="{StaticResource Brush.Stroke.Default}" BorderThickness="1"
                Padding="4,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource Glyph.Font}"
                           FontSize="14" Foreground="{StaticResource Brush.Text.Tertiary}"
                           VerticalAlignment="Center" Margin="6,0,6,0"/>
                <!-- 注意 Padding="0" 不能省：WPF-UI 的隐式 Button 样式带大内边距，
                     固定 Width=30 的按钮内容区会被挤到只剩几像素，图标字形被横向裁掉一半
                     （实测：齿轮和电源图标都只画出左半边，看着像坏字形）。 -->
                <Button DockPanel.Dock="Right" Width="30" Height="26" Padding="0" Margin="4,0,0,0" Cursor="Hand"
                        ToolTip="设置 (F12)" Click="OnSettingsClick" Focusable="False">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Glyph.Font}" FontSize="13"
                               Foreground="{StaticResource Brush.Text.Secondary}"/>
                </Button>
                <!-- 直达后端程序：一个后端一个按钮（只有声明 IExternalUiProvider 且可用的后端才出现）。
                     用 ItemsControl 而不是写死按钮，将来 AnyTXT/Zotero 接上会自动多出来。 -->
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding BackendTargets}"
                              VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BackendTarget}">
                            <Button Height="26" MinWidth="30" Margin="4,0,0,0" Padding="6,0" Cursor="Hand"
                                    Focusable="False" ToolTip="{Binding TooltipText}"
                                    Command="{Binding DataContext.OpenInBackendCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Glyph.Font}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding Name}" Margin="5,0,0,0" VerticalAlignment="Center"
                                               FontFamily="{StaticResource Font.Text}"
                                               FontSize="{StaticResource Font.Size.Secondary}"
                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Style={x:Null}：清掉 WPF-UI 的隐式 TextBox 样式，紧凑界面不需要它自带的外框 -->
                <TextBox x:Name="SearchBox" Style="{x:Null}"
                         Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" Padding="2,0"
                         FontFamily="{StaticResource Font.Text}" FontSize="{StaticResource Font.Size.Search}"
                         Foreground="{StaticResource Brush.Text.Primary}"
                         SelectionBrush="{StaticResource Brush.Accent}"
                         CaretBrush="{StaticResource Brush.Accent}"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ── 三栏主体：来源 | （筛选行 + 结果表） | 预览 ────────
             筛选行刻意放在**中间列内部**：它是"当前来源下的结果筛选"，属于列表而不属于整个窗口 ——
             横跨到左栏上方会让人以为它管的是来源本身。 -->
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SourceColumn" Width="{StaticResource SideBar.Width}"
                                  MinWidth="{StaticResource SideBar.MinWidth}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ResultColumn" Width="*" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="{StaticResource Preview.Width}"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左栏：来源（决定搜哪些后端，不只是过滤显示）── -->
            <Border x:Name="SourcePane" Grid.Column="0"
                    Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Stroke.Default}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Default}">
                <DockPanel>
                    <!-- 头部：标题 + 紧凑/展开切换（大 = 名称+状态；小 = 图标+数量） -->
                    <Grid DockPanel.Dock="Top" Margin="6,6,6,2">
                        <TextBlock Text="来源" VerticalAlignment="Center" Margin="4,0,0,0"
                                   FontSize="{StaticResource Font.Size.SectionTitle}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   Visibility="{Binding IsSourceBarCompact, Converter={StaticResource InverseBoolToVis}}"/>
                        <Button HorizontalAlignment="Right" Width="22" Height="22" Padding="0" Cursor="Hand"
                                Focusable="False" Click="OnToggleSourceBar"
                                ToolTip="紧凑 / 展开来源栏 (Ctrl+B)">
                            <TextBlock FontFamily="{StaticResource Glyph.Font}" FontSize="11"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="{Binding SourceBarToggleGlyph}"/>
                        </Button>
                    </Grid>

                    <TextBlock DockPanel.Dock="Bottom" Margin="8,4,8,8" TextWrapping="Wrap"
                               Text="点击 = 本次只搜它；再点一次取消限定"
                               FontSize="{StaticResource Font.Size.Chip}"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               Visibility="{Binding IsSourceBarCompact, Converter={StaticResource InverseBoolToVis}}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <!-- 形态一（大）：图标 + 名称 + 状态 + 「默认」标 -->
                            <ItemsControl ItemsSource="{Binding Sources}" Margin="4,0"
                                          ItemTemplate="{StaticResource SourceItemTemplate}" Focusable="False"
                                          Visibility="{Binding IsSourceBarCompact, Converter={StaticResource InverseBoolToVis}}"/>
                            <!-- 形态二（小）：只有后端图标 + 下面一行数量（>9999 一律写 ">9999"） -->
                            <ItemsControl ItemsSource="{Binding Sources}" Margin="0,2"
                                          ItemTemplate="{StaticResource SourceCompactTemplate}" Focusable="False"
                                          Visibility="{Binding IsSourceBarCompact, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="SourceSplitter" Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

            <!-- ── 中间：筛选行 + 结果表 ──────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 筛选行：内容随当前来源与<b>模板</b>变化（每个后端可以有自己的筛选器集与默认模板）。
                     用 WrapPanel 而不是横向滚动：滚动条会吃掉一行高度，而且"有标签被藏在右边"
                     用户根本看不出来；换行最多多占一行，但一个都不会丢。
                     DockPanel 是为了把"模板锚点"固定在标签栏最左 —— 它不该跟着标签一起换行。 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,2">
                    <!-- 模板锚点：显示当前模板名，点一下弹下拉。没有 templates 节时整块不显示
                         （升级第一天不该多出一个按不动的按钮）。 -->
                    <Button DockPanel.Dock="Left" x:Name="TemplateAnchor" Style="{x:Null}"
                            Margin="0,0,4,1" Padding="6,1" Cursor="Hand" MinWidth="0"
                            Visibility="{Binding HasTemplates, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding TemplateAnchorTip}"
                            Click="OnTemplateAnchorClick"
                            FontFamily="{StaticResource Font.Text}" FontSize="{StaticResource Font.Size.FilterTab}"
                            Foreground="{StaticResource Brush.Text.Primary}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Ta" CornerRadius="{StaticResource Radius.Default}"
                                        Background="{StaticResource Brush.Chip.Neutral}"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71C;" FontFamily="{StaticResource Glyph.Font}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"/>
                                        <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Ta" Property="Background" Value="{StaticResource Brush.Subtle.Hover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <!-- ContextMenu 有自己的可视树、绑不到 Window，所以经 PlacementTarget 取回 VM
                                 （和结果行的右键菜单同一套办法）。 -->
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="筛选器模板" IsEnabled="False" FontWeight="Bold"/>
                                <Separator/>
                                <MenuItem ItemsSource="{Binding TemplateOptions}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}"/>
                                            <Setter Property="IsCheckable" Value="True"/>
                                            <Setter Property="IsChecked" Value="{Binding IsActive, Mode=OneWay}"/>
                                            <Setter Property="ToolTip" Value="{Binding TooltipText}"/>
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.SelectTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Setter Property="CommandParameter" Value="{Binding Id}"/>
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="跟随后端默认(_D)" IsCheckable="True"
                                          IsChecked="{Binding TemplateFollowsDefault, Mode=OneWay}"
                                          ToolTip="{Binding ResetTemplateTip}"
                                          Command="{Binding ResetTemplateCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <TextBlock Text="{Binding TemplateLabel}"/>
                    </Button>

                    <!-- 值域筛选器（标签）：候选值来自后端自己，可能有上百个，所以**不摊在标签栏上**。
                         这里只有一枚带小三角的锚点，点开弹面板；标签栏上只回显已选的那几个。 -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,4,0"
                                Visibility="{Binding HasFacet, Converter={StaticResource BoolToVis}}">

                        <ToggleButton x:Name="FacetAnchor" Style="{x:Null}"
                                      Margin="0,0,2,1" Padding="6,1" Cursor="Hand" MinWidth="0"
                                      IsChecked="{Binding IsFacetOpen, Mode=TwoWay}"
                                      ToolTip="{Binding FacetAnchorTip}"
                                      AutomationProperties.AutomationId="FacetAnchor"
                                      AutomationProperties.Name="{Binding FacetLabel}"
                                      FontFamily="{StaticResource Font.Text}"
                                      FontSize="{StaticResource Font.Size.FilterTab}"
                                      Foreground="{StaticResource Brush.Text.Primary}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Fa" CornerRadius="{StaticResource Radius.Default}"
                                            Background="{StaticResource Brush.Chip.Neutral}"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FacetGlyph}" FontFamily="{StaticResource Glyph.Font}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.Text.Secondary}"/>
                                            <TextBlock Text="{Binding FacetLabel}" Margin="4,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <!-- 小三角：告诉用户"这里点得开"，而不是一枚按下去没反应的死标签 -->
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Glyph.Font}"
                                                       FontSize="8" Margin="4,1,0,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.Text.Secondary}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Fa" Property="Background" Value="{StaticResource Brush.Subtle.Hover}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Fa" Property="Background" Value="{StaticResource Brush.Subtle}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- 已选回显：顶部"只显示已经选择的标签"，每个带 × 可单独摘掉 -->
                        <ItemsControl ItemsSource="{Binding SelectedFacets}"
                                      ItemTemplate="{StaticResource FacetChipTemplate}"
                                      VerticalAlignment="Center" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Popup x:Name="FacetPopup" PlacementTarget="{Binding ElementName=FacetAnchor}"
                               Placement="Bottom" IsOpen="{Binding IsFacetOpen, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <!-- Popup 的内容不在主可视树上，往上找不到 Window；用 PlacementTarget
                                 把锚点的 DataContext（= 同一个 VM）取回来，后面的绑定才有着落。 -->
                            <Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=Popup}}"
                                    Background="{StaticResource Brush.Surface.Card}"
                                    BorderBrush="{StaticResource Brush.Stroke.Default}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Padding="4" MinWidth="220" MaxWidth="360">
                                <DockPanel>
                                    <!-- 底部：多值口径 + 清空。口径必须在看得见的地方 —— 
                                         "两个标签一条都没有"多半不是筛坏了，而是口径是「全部命中」。 -->
                                    <Grid DockPanel.Dock="Bottom" Margin="2,4,2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="0" Style="{x:Null}" HorizontalAlignment="Left"
                                                      Padding="5,1" Cursor="Hand" MinWidth="0"
                                                      IsChecked="{Binding FacetMatchAll, Mode=OneWay}"
                                                      Command="{Binding ToggleFacetMatchAllCommand}"
                                                      ToolTip="{Binding FacetMatchAllTip}"
                                                      FontFamily="{StaticResource Font.Text}"
                                                      FontSize="{StaticResource Font.Size.Chip}"
                                                      Foreground="{StaticResource Brush.Text.Primary}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Mb" CornerRadius="{StaticResource Radius.Chip}"
                                                            Background="{StaticResource Brush.Chip.Neutral}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="{Binding FacetMatchAllLabel}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Mb" Property="Background" Value="{StaticResource Brush.Subtle.Hover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <Button Grid.Column="1" Style="{x:Null}" Padding="5,1" Cursor="Hand" MinWidth="0"
                                                Command="{Binding ClearFacetValuesCommand}"
                                                FontFamily="{StaticResource Font.Text}"
                                                FontSize="{StaticResource Font.Size.Chip}"
                                                Foreground="{StaticResource Brush.Text.Secondary}"
                                                ToolTip="清空已选">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Cb" CornerRadius="{StaticResource Radius.Chip}"
                                                            Background="Transparent" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="清空"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Cb" Property="Background" Value="{StaticResource Brush.Subtle.Hover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <!-- 读候选值失败要如实说，不要留一个空白面板（分不清"没标签"和"读不到"） -->
                                    <TextBlock DockPanel.Dock="Top" Margin="6,4,6,4" TextWrapping="Wrap"
                                               Text="{Binding FacetError}"
                                               FontFamily="{StaticResource Font.Text}"
                                               FontSize="{StaticResource Font.Size.Chip}"
                                               Foreground="{StaticResource Brush.Chip.Danger}"
                                               Visibility="{Binding FacetError, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock DockPanel.Dock="Top" Margin="6,4,6,4"
                                               Text="正在读取候选值…"
                                               FontFamily="{StaticResource Font.Text}"
                                               FontSize="{StaticResource Font.Size.Chip}"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               Visibility="{Binding IsFacetLoading, Converter={StaticResource BoolToVis}}"/>

                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding FacetCandidates}"
                                                      ItemTemplate="{StaticResource FacetCandidateTemplate}"
                                                      Focusable="False"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Tabs}"
                                  ItemTemplate="{StaticResource CategoryTabTemplate}"
                                  Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>

                <Grid Grid.Row="1">
                    <ListView x:Name="ResultList"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding Selected, Mode=OneWay}"
                              SelectionChanged="OnResultSelectionChanged"
                              ItemContainerStyle="{StaticResource ResultRowStyle}"
                              SelectionMode="Extended"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              SizeChanged="OnResultListSizeChanged"
                              MouseDoubleClick="OnResultDoubleClick"
                              PreviewMouseLeftButtonDown="OnResultPreviewMouseLeftDown"
                              PreviewMouseMove="OnResultPreviewMouseMove"
                              PreviewMouseWheel="OnResultPreviewMouseWheel">
                        <ListView.View>
                            <GridView x:Name="ResultGrid"
                                      AllowsColumnReorder="True"
                                      ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}"/>
                        </ListView.View>
                    </ListView>

                    <!-- 空态：不留一片空白让人以为卡住了 -->
                    <TextBlock Text="{Binding EmptyHint}" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                               FontSize="{StaticResource Font.Size.Secondary}"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>

            <GridSplitter x:Name="PreviewSplitter" Grid.Column="3" Width="5"
                          HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

            <!-- ── 右栏：预览 + 选中项信息 ──────────────────────
                 按类型走不同模板：图片原生渲染 / 文本直接显示 / 其余用 shell 缩略图。
                 Detail 放"大小 · 修改时间"，Message 用于如实说"没有可用预览"。 -->
            <Border x:Name="PreviewPane" Grid.Column="4"
                    Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Stroke.Default}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Default}">
                <DockPanel>
                    <!-- 选中项摘要：标题 / 路径 / 类型·大小·时间·来源 -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,6,8,6">
                        <Grid>
                            <TextBlock Text="{Binding Selected.Title}" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,26,0" FontWeight="SemiBold"
                                       FontSize="{StaticResource Font.Size.SectionTitle}"
                                       Foreground="{StaticResource Brush.Text.Primary}"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="22" Height="22" Padding="0" Cursor="Hand" Focusable="False"
                                    Click="OnTogglePreview" ToolTip="收起预览栏 (Ctrl+J)">
                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Glyph.Font}" FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding Selected.FullPath}" TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" ToolTip="{Binding Selected.FullPath}"
                                   FontSize="{StaticResource Font.Size.Chip}"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"/>
                        <WrapPanel Margin="0,3,0,0">
                            <TextBlock Text="{Binding Selected.KindName}" Margin="0,0,8,0"
                                       FontSize="{StaticResource Font.Size.Chip}"
                                       Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding Selected.SizeText}" Margin="0,0,8,0"
                                       FontSize="{StaticResource Font.Size.Chip}"
                                       Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding Selected.ModifiedText}" Margin="0,0,8,0"
                                       FontSize="{StaticResource Font.Size.Chip}"
                                       Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding Selected.ProviderLabel}"
                                       FontSize="{StaticResource Font.Size.Chip}"
                                       Foreground="{StaticResource Brush.Text.Tertiary}"/>
                        </WrapPanel>
                        <Border Height="1" Margin="0,6,0,0" Background="{StaticResource Brush.Stroke.Subtle}"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Margin="8,4,8,6"
                               FontSize="{StaticResource Font.Size.Secondary}"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding PreviewContent.Detail}"
                               Visibility="{Binding PreviewContent.HasDetail, Converter={StaticResource BoolToVis}}"/>

                    <Grid Margin="8,0,8,0">
                        <!-- 图片：只缩不放（StretchDirection=DownOnly），小图别被拉糊 -->
                        <Image Source="{Binding PreviewContent.Image}" Stretch="Uniform"
                               StretchDirection="DownOnly"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVis}}"/>

                        <!-- 文本：等宽 + 不换行，代码/日志才对得齐 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasPreviewText, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding PreviewContent.Text}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="{StaticResource Font.Size.Primary}" TextWrapping="NoWrap"
                                       Foreground="{StaticResource Brush.Text.Primary}"/>
                        </ScrollViewer>

                        <!-- 没有预览时如实说明，而不是留一片空白让人以为卡住了 -->
                        <TextBlock Text="{Binding PreviewContent.Message}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   FontSize="{StaticResource Font.Size.Secondary}"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"
                                   Visibility="{Binding HasPreviewMessage, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 预览收起后的"把手"：不留一条把手，用户就只剩快捷键能把它叫回来。
                 可见性由 code-behind 统一管（和 PreviewPane 成对），不在 XAML 里再绑一次。 -->
            <Border x:Name="PreviewRail" Grid.Column="4" Width="22" HorizontalAlignment="Right"
                    Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Stroke.Default}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Default}"
                    Cursor="Hand" ToolTip="展开预览栏 (Ctrl+J)"
                     MouseLeftButtonUp="OnPreviewRailMouseUp"
                     Visibility="Collapsed">
                <Button VerticalAlignment="Stretch" VerticalContentAlignment="Center" Padding="0" Cursor="Hand" Focusable="False"
                        Click="OnTogglePreview" ToolTip="展开预览栏 (Ctrl+J)">
                    <TextBlock Text="&#xE76B;" FontFamily="{StaticResource Glyph.Font}" FontSize="14"
                               Foreground="{StaticResource Brush.Text.Secondary}"/>
                </Button>
            </Border>
        </Grid>

        <!-- ── 状态条 ───────────────────────────────────── -->
        <Border Grid.Row="2" Height="{StaticResource Status.Height}" Margin="0,4,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ScopeLabel}"
                           FontSize="{StaticResource Font.Size.Secondary}"
                           Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="{StaticResource Font.Size.Secondary}"
                           Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
