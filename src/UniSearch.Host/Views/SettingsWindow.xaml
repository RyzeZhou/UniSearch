<Window x:Class="UniSearch.Host.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UniSearch 设置"
        Width="620" Height="620" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Surface}"
        FontFamily="{StaticResource Font.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!-- 分组标题：区域标题比内部元素大一档（见 Tokens.xaml 的字号规矩） -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Size.SectionTitle}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- 行的说明文字 -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Secondary}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Secondary}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <!-- 卡片容器 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Default}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Secondary}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="Button">
            <!-- WPF-UI 的隐式 Button 样式内边距很大，紧凑界面里必须自己收紧 -->
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Secondary}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Secondary}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <!-- x:Name 是给 dump-settings 自检开关用的：直接渲染这个 StackPanel，
                 能拍到整份设置（长图），不受"窗口最多只有屏幕高"的限制。 -->
            <StackPanel x:Name="SettingsContent">

                <!-- ── 全局热键 ───────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="全局热键"/>
                        <CheckBox x:Name="HotkeysEnabledBox" Content="启用全局热键"
                                  IsChecked="{Binding Hotkeys.Enabled, Mode=TwoWay}"
                                  Checked="OnHotkeysToggled" Unchecked="OnHotkeysToggled"/>

                        <StackPanel x:Name="HotkeyFields" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="唤出" Width="150"/>
                                <TextBox x:Name="SummonBox" Width="200" IsReadOnly="True" Cursor="Hand"
                                         Text="{Binding Hotkeys.Summon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="OnGestureKeyDown" GotKeyboardFocus="OnGestureFocus"
                                         LostKeyboardFocus="OnGestureBlur"
                                         ToolTip="点这里，然后按下想用的组合键"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="点输入框后直接按组合键即可。建议保留默认值：它不抢任何其它程序的功能键。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="限定到资源管理器目录" Width="150"/>
                                <TextBox x:Name="DirBox" Width="200" IsReadOnly="True" Cursor="Hand"
                                         Text="{Binding Hotkeys.DirectoryScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="OnGestureKeyDown" GotKeyboardFocus="OnGestureFocus"
                                         LostKeyboardFocus="OnGestureBlur"
                                         ToolTip="点这里，然后按下想用的组合键"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="按下时会打开搜索并限定到前台资源管理器的当前目录。注意它会全局接管资源管理器原本的 Ctrl+F；前台不是资源管理器时自动退回全局搜索。"/>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="想取消某一个热键：点进输入框按 Delete 清空即可（留空 = 不注册）。至少要有一个修饰键（Ctrl / Alt / Shift / Win）。"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 搜索 ──────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="搜索"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="列表最多显示" Width="220"/>
                            <TextBox x:Name="MaxRowsBox" Width="80"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="行" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="结果表是单表平铺（Everything 口径），这是总行数上限。超出时状态条会如实写「显示 N / 共 M 条」—— 藏起来的不是丢了。"/>

                        <CheckBox Content="过滤隐藏文件与系统文件"
                                  IsChecked="{Binding Search.FilterHiddenAndSystem, Mode=TwoWay}"/>
                        <CheckBox Content="排除系统噪声位置（回收站 / WinSxS / servicing / Windows.old）"
                                  IsChecked="{Binding Search.ExcludeNoisePaths, Mode=TwoWay}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="回收站是原文件的重复副本，WinSxS 是组件仓库 —— 这些命中几乎从不是想要的。"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="额外排除目录（每行一个，支持写成路径片段）"/>
                        <TextBox x:Name="ExtraExcludeBox" Height="64" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource Font.Mono}"
                                 VerticalContentAlignment="Top"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="例如 D:\临时 或 node_modules。按路径片段匹配，所以写目录名也能生效。"/>
                    </StackPanel>
                </Border>

                <!-- ── 列表与列 ──────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="列表与列"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4"
                                   Text="随输入自动搜索的后端（逗号分隔的后端 id）"/>
                        <TextBox x:Name="AutoProvidersBox" Width="260" HorizontalAlignment="Left"
                                 FontFamily="{StaticResource Font.Mono}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="默认只有 everything。其它后端（将来的 AnyTXT 等）不会在你每次打字时被拉起来 —— 要搜它们，请在主窗口左侧「来源」栏点它（再点一次取消限定）。"/>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" x:Name="ColumnsHint"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="恢复默认列布局" Click="OnResetColumns" Margin="0"/>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Text="也可以直接在结果表的列头上右键：增减列、左右移动、恢复默认。"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 筛选器（filters.json）────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="筛选器"/>
                        <TextBlock x:Name="FiltersHint" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="筛选器是结果表上方那排标签（全部 / 文件 / 图片 / 生信相关…）。可以自己加：在 JSON 里写一组扩展名、类型或文件名正则即可，还能限定只对某个搜索后端显示。"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="编辑我的筛选器" Click="OnEditMyFilters" Margin="0"/>
                            <Button Content="打开筛选器目录" Click="OnOpenFiltersFolder"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 预览 ──────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="预览"/>
                        <CheckBox Content="默认展开预览窗格"
                                  IsChecked="{Binding Preview.OpenByDefault, Mode=TwoWay}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="运行中随时可以按 Ctrl+J 开合，这个只是启动时的默认状态。"/>
                    </StackPanel>
                </Border>

                <!-- ── 窗口与托盘 ────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="窗口与托盘"/>
                        <CheckBox x:Name="CloseToTrayBox" Content="点关闭按钮时收进托盘（不退出程序）"
                                  IsChecked="{Binding Window.CloseToTray, Mode=TwoWay}"
                                  Checked="OnCloseToTrayToggled" Unchecked="OnCloseToTrayToggled"/>
                        <TextBlock x:Name="CloseToTrayHint" Style="{StaticResource Hint}"
                                   Text="收进托盘后热键仍然可以唤回；退出程序请右键任务栏托盘图标 → 退出 UniSearch。"/>
                        <CheckBox Content="第一次收进托盘时提示一次"
                                  IsChecked="{Binding Window.NotifyOnFirstHide, Mode=TwoWay}"/>
                        <CheckBox Content="开机自启动（默认关）"
                                  IsChecked="{Binding Window.AutoStartAtLogin, Mode=TwoWay}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="在注册表 HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Run 里增删 UniSearch 项。"/>
                    </StackPanel>
                </Border>

                <!-- ── 提供者 ────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="提供者"/>
                        <CheckBox x:Name="EverythingBox" Content="Everything（文件名与路径索引）"
                                  IsChecked="{Binding Providers[everything].Enabled, Mode=TwoWay}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="禁用后 UniSearch 将没有任何搜索来源。也可以直接编辑 settings.json 里的 providers 节。"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 状态/报错行 -->
        <TextBlock Grid.Row="1" x:Name="StatusLine" Margin="0,8,0,0" TextWrapping="Wrap"
                   FontFamily="{StaticResource Font.Text}"
                   FontSize="{StaticResource Font.Size.Secondary}"
                   Foreground="{StaticResource Brush.Text.Secondary}"
                   Text="设置保存在 %LOCALAPPDATA%\UniSearch\settings.json"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="恢复默认" Click="OnResetDefaults" HorizontalAlignment="Left"/>
            <Button Content="打开设置文件位置" Click="OnOpenSettingsFolder"/>
            <Button Content="取消" Click="OnCancel" IsCancel="True"/>
            <Button Content="保存" Click="OnSave" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
